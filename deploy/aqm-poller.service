[Unit]
Description=Air Quality Monitor - Poller (ZN-MT29 ingest)
After=network-online.target mongod.service
Wants=network-online.target
Requires=mongod.service

[Service]
Type=simple
# Adjust User and paths to your deployment.
User=pi
WorkingDirectory=/opt/air_quality_monitor
Environment=AQM_CONFIG=/opt/air_quality_monitor/config.yaml
ExecStart=/opt/air_quality_monitor/.venv/bin/python -m aqm.poller_main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
